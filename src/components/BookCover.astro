---
import { copy } from '../content/copy';
import { site } from '../config';
import { cover } from '../cover';
import { withBase } from '../url';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  small?: boolean;
}

const { lang, small = false } = Astro.props;
const t = copy[lang];
const sizes = small ? '(min-width: 56rem) 272px, 80vw' : '(min-width: 56rem) 416px, 90vw';
---

{
  cover ? (
    <div class:list={['book-cover', { 'book-cover--small': small }]}>
      <img class="cover-real" src={cover.src} srcset={cover.srcset} sizes={sizes} alt={t.cover.alt} width="1000" height="1000" fetchpriority={small ? undefined : 'high'} decoding="async" />
    </div>
  ) : (
    <div class:list={['book-cover', 'book-cover--provisional', { 'book-cover--small': small }]} role="img" aria-label={t.cover.alt}>
      <span class="t-lead" translate="no">{t.cover.provisionalTitle}</span>
      <span class="t-rest">{t.cover.provisionalSubtitle}</span>
      <span class="t-author">{site.author}</span>
      <img src={withBase('/textures/triangulos-base.webp')} alt="" width="2000" height="260" loading="lazy" />
    </div>
  )
}
