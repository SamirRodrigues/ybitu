---
import Base from '../layouts/Base.astro';
import LeadSection from '../components/LeadSection.astro';
import ResearchItem from '../components/ResearchItem.astro';
import { copy } from '../content/copy';
import { research } from '../data/research';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const r = copy[lang].research;
---

<Base lang={lang} route="research" title={r.title} description={r.description}>
  <div class="page-head">
    <div class="wrap">
      <h1>{r.title}</h1>
      <p class="lede">{r.intro}</p>
    </div>
  </div>

  <section class="section" style="padding-top:1rem" aria-label={r.title}>
    <div class="wrap">
      <ul class="research-list">
        {research.map((item) => <ResearchItem item={item} lang={lang} />)}
      </ul>
    </div>
  </section>

  <LeadSection lang={lang} />
</Base>
