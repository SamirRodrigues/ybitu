---
import fs from 'node:fs';
import nodePath from 'node:path';
import Base from '../layouts/Base.astro';
import BookCover from '../components/BookCover.astro';
import LeadSection from '../components/LeadSection.astro';
import { copy } from '../content/copy';
import { narrators } from '../data/community';
import { site } from '../config';
import { pick, type Lang } from '../i18n';
import { withBase } from '../url';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const b = t.book;

// Retratos opcionais: public/images/autora.webp e public/images/ilustrador.webp (ou .jpg/.png).
const portrait = (base: string) =>
  ['webp', 'jpg', 'jpeg', 'png']
    .map((ext) => `${base}.${ext}`)
    .find((name) => fs.existsSync(nodePath.join(process.cwd(), 'public', 'images', name)));
const authorPhoto = portrait('autora');
const illustratorPhoto = portrait('ilustrador');
const available = site.book.status === 'available' && site.book.buyUrl !== '';
---

<Base lang={lang} route="book" title={b.title} description={b.description}>
  <div class="page-head">
    <div class="wrap">
      <h1>{b.title}</h1>
    </div>
  </div>

  <section class="section section--flush" aria-labelledby="obra-titulo">
    <div class="wrap about-grid">
      <BookCover lang={lang} />
      <div class="stack measure">
        <h2 id="obra-titulo">{b.aboutTitle}</h2>
        <p class="about-hook">{b.hook}</p>
        {b.about.map((paragraph) => <p class="lede">{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="section section--flush" aria-labelledby="ficha-titulo">
    <div class="wrap stack">
      <h2 id="ficha-titulo">{b.factsTitle}</h2>
      <dl class="facts facts--row">
        {b.facts.map((fact) => <div><dt>{fact.label}</dt><dd>{fact.value}</dd></div>)}
        <div class="facts-wide">
          <dt>{b.narratorsLabel}</dt>
          <dd>
            <ul class="fact-people fact-people--cols">
              {narrators.map((person) => <li><strong>{person.name}</strong><span>{pick(person.role, lang)}</span></li>)}
            </ul>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section section--stone" aria-labelledby="autora-titulo">
    <div class="wrap two-col">
      <div class="stack measure">
        <h2 id="autora-titulo">{b.authorTitle}</h2>
        <p>{site.author}</p>
        <p>{b.authorBio}</p>
        <p>
          <a href={site.authorLattes} target="_blank" rel="noopener noreferrer">{b.lattes} <span class="sr-only">{t.a11y.opensNewTab}</span></a>
        </p>
      </div>
      <div>
        {
          authorPhoto ? (
            <img class="portrait" src={withBase(`/images/${authorPhoto}`)} alt={b.authorPhotoAlt} width="176" height="176" loading="lazy" />
          ) : (
            <div class="portrait placeholder-box" aria-hidden="true">{t.community.photoSoon}</div>
          )
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="ilustrador-titulo">
    <div class="wrap two-col">
      <div class="stack measure">
        <h2 id="ilustrador-titulo">{b.illustratorTitle}</h2>
        <p>{b.illustratorName}</p>
        <p>{b.illustratorBio}</p>
      </div>
      <div>
        {
          illustratorPhoto ? (
            <img class="portrait" src={withBase(`/images/${illustratorPhoto}`)} alt={b.illustratorPhotoAlt} width="176" height="176" loading="lazy" />
          ) : (
            <div class="portrait placeholder-box" aria-hidden="true">{t.community.photoSoon}</div>
          )
        }
      </div>
    </div>
  </section>

  {
    available ? (
      <section class="section section--brick on-dark" id="avise-me" aria-labelledby="comprar-titulo">
        <div class="wrap stack">
          <h2 id="comprar-titulo">{b.buyTitle}</h2>
          <p><a class="btn btn--ghost" style="color:#fff;border-color:#fff" href={site.book.buyUrl}>{b.buyNow}</a></p>
        </div>
      </section>
    ) : (
      <LeadSection lang={lang} title={b.buyTitle} intro={b.buySoon} />
    )
  }
</Base>
