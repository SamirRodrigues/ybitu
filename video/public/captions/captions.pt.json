[
 {
  "startMs": 150,
  "endMs": 1904,
  "text": "Há memórias que não se apagam."
 },
 {
  "startMs": 1904,
  "endMs": 5243,
  "text": "Elas só adormecem, esperando\nalguém para acordá-las."
 },
 {
  "startMs": 5693,
  "endMs": 8140,
  "text": "Nas terras do Catu, no Rio\nGrande do Norte,"
 },
 {
  "startMs": 8140,
  "endMs": 9391,
  "text": "vive o povo potiguara."
 },
 {
  "startMs": 9391,
  "endMs": 9733,
  "text": "E ali,"
 },
 {
  "startMs": 9733,
  "endMs": 13033,
  "text": "professores guardam e contam\nhistórias sobre a sua língua,"
 },
 {
  "startMs": 13033,
  "endMs": 14812,
  "text": "a sua escola e o seu povo."
 },
 {
  "startMs": 15262,
  "endMs": 18481,
  "text": "Essas histórias viraram Ybitu:\num livro infantil inédito,"
 },
 {
  "startMs": 18481,
  "endMs": 20232,
  "text": "escrito no Rio Grande do Norte,"
 },
 {
  "startMs": 20232,
  "endMs": 22378,
  "text": "sobre os indígenas potiguaras do\nCatu."
 },
 {
  "startMs": 22378,
  "endMs": 24920,
  "text": "Para que as crianças conheçam\nessas memórias,"
 },
 {
  "startMs": 24920,
  "endMs": 26632,
  "text": "e nunca mais as esqueçam."
 },
 {
  "startMs": 27262,
  "endMs": 28678,
  "text": "A pré-venda está aberta."
 },
 {
  "startMs": 28678,
  "endMs": 31511,
  "text": "São cinquenta e cinco reais, só\npelo nosso site,"
 },
 {
  "startMs": 31511,
  "endMs": 33227,
  "text": "e temos poucas unidades."
 },
 {
  "startMs": 34262,
  "endMs": 35467,
  "text": "Acorde essa memória."
 },
 {
  "startMs": 35467,
  "endMs": 38658,
  "text": "Reserve o seu em\nybituolivro.com.br."
 }
]
