[
 {
  "startMs": 150,
  "endMs": 1875,
  "text": "Hay memorias que no se borran."
 },
 {
  "startMs": 1875,
  "endMs": 5165,
  "text": "Solo duermen, esperando a\nalguien que las despierte."
 },
 {
  "startMs": 5615,
  "endMs": 8330,
  "text": "En las tierras de Catu, en Rio\nGrande do Norte,"
 },
 {
  "startMs": 8330,
  "endMs": 9774,
  "text": "vive el pueblo potiguara."
 },
 {
  "startMs": 9774,
  "endMs": 10179,
  "text": "Y allí,"
 },
 {
  "startMs": 10179,
  "endMs": 13587,
  "text": "los profesores guardan y cuentan\nhistorias sobre su lengua,"
 },
 {
  "startMs": 13587,
  "endMs": 15216,
  "text": "su escuela y su pueblo."
 },
 {
  "startMs": 15666,
  "endMs": 18831,
  "text": "Esas historias se volvieron\nYbitu: un libro infantil"
 },
 {
  "startMs": 18831,
  "endMs": 21265,
  "text": "inédito, escrito en Rio Grande\ndo Norte,"
 },
 {
  "startMs": 21265,
  "endMs": 23638,
  "text": "sobre los indígenas potiguaras\nde Catu."
 },
 {
  "startMs": 23638,
  "endMs": 26194,
  "text": "Para que los niños conozcan esas\nmemorias,"
 },
 {
  "startMs": 26194,
  "endMs": 27955,
  "text": "y nunca más las olviden."
 },
 {
  "startMs": 28405,
  "endMs": 29948,
  "text": "La preventa está abierta."
 },
 {
  "startMs": 29948,
  "endMs": 32416,
  "text": "Son cincuenta y cinco reales\nbrasileños,"
 },
 {
  "startMs": 32416,
  "endMs": 35617,
  "text": "solo en nuestro sitio, y quedan\npocas unidades."
 },
 {
  "startMs": 36067,
  "endMs": 37495,
  "text": "Despierta esa memoria."
 },
 {
  "startMs": 37495,
  "endMs": 41039,
  "text": "Reserva el tuyo en\nybituolivro.com.br."
 }
]
